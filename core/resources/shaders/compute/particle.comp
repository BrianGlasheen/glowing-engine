#version 460
layout(local_size_x = 128) in;

struct Particle {
    vec4 position; // xyz = pos, w = lifetime
    vec4 velocity; // xyz = vel
};

layout(std430, binding = 0) buffer Particles {
    Particle particles[];
};

uniform float dt;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= particles.length()) return;

    particles[i].position.xyz += particles[i].velocity.xyz * dt;
    particles[i].position.w -= dt;

    if (particles[i].position.w <= 0.0) {
        particles[i].position.xyz = vec3(0.0, 10.0, 0.0);
        particles[i].velocity.xyz = vec3(
            (fract(sin(i * 12.9898) * 43758.5453) - 0.5) * 2.0,
            (fract(sin(i * 728.233) * 125.6789) - 0.5) * 2.0,
            (fract(sin(i * 78.233) * 12345.6789) - 0.5) * 2.0
        );
        particles[i].position.w = 3.0 + fract(sin(i * 91.234) * 56789.123) * 4.0;
    }
}
