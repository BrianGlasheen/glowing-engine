#version 460 core

layout(local_size_x = 64) in;

struct Animation_Command {
    uint base_bone;
    uint bone_count;
    uint bone_offset;
    uint base_leaf;

    uint leaf_count;
    uint base_bone_animation; // first bone animation, fill from g_animations
    uint bone_animation_count; // num of bone animations
    float duration;

    uint leaf_thread_offset; // explain
    bool loop;

    // todo add entity index to check if needs animate
    uint padding[2];
};

struct GPU_Bone {
    mat4 inverse_bind;
    uint parent_bone;
    uint padding[3];
};

struct GPU_Bone_Skinned {
    mat4 transform;
};

struct Position_Keyframe {
    vec3 position;
    float time;
};

struct quat {
    float x, y, z, w;
};

struct Rotation_Keyframe {
    quat rotation;
    float time;
    uint padding[3];
};

struct Scale_Keyframe{
    vec3 scale;
    float time;
};

struct GPU_Bone_Animation {
    uint bone_index;
    uint base_position_keyframe;
    uint position_keyframe_count;
    uint base_rotation_keyframe;
    uint rotation_keyframe_count;
    uint base_scale_keyframe;
    uint scale_keyframe_count;
    uint padding;
};

layout(std430, binding = 0) buffer Animation_Commands {
    Animation_Command animation_commands[];
};

layout(std430, binding = 1) buffer Leaf_Bones {
    uint leaf_bones[];
};

layout(std430, binding = 2) buffer GPU_Bones {
    GPU_Bone gpu_bones[];
};

layout(std430, binding = 3) buffer GPU_Bones_Skinned {
    GPU_Bone_Skinned gpu_bones_skinned[];
};

layout(std430, binding = 4) buffer Absolute_Bone_Transform {
    mat4 absolute_bone_transforms[];
};

layout(std430, binding = 5) buffer Transform_Times {
    float transform_times[];
};

layout(std430, binding = 6) buffer GPU_Bone_Animations {
    GPU_Bone_Animation gpu_bone_animations[];
};

layout(std430, binding = 7) buffer Position_Keyframes {
    Position_Keyframe position_keyframes[];
};

layout(std430, binding = 8) buffer Rotation_Keyframes {
    Rotation_Keyframe rotation_keyframes[];
};

layout(std430, binding = 9) buffer Scale_Keyframes {
    Scale_Keyframe scale_keyframes[];
};

// todo add animation buffer

uniform float dispatch_time;
uniform uint num_animation_cmds;

//uniform uint max_leaf; // todo pack into animate cmd + base leaf + base animation + animation_count + output offset
