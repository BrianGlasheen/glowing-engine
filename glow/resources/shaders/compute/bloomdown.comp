#version 460

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0) uniform sampler2D inputMip;
//layout(binding = 0, rgba16f) uniform readonly image2D inputMip;
layout(binding = 1, rgba16f) uniform writeonly image2D outputMip;

uniform float bloomThreshold = 1.0;
uniform float bloomKnee = 0.1;
uniform int mipLevel = 0; // 0 = first downsample (apply threshold), >0 = subsequent levels

// Soft threshold for HDR bloom extraction
vec3 QuadraticThreshold(vec3 color, float threshold, float knee) {
    float brightness = max(color.r, max(color.g, color.b));
    float rq = clamp(brightness - threshold + knee, 0.0, 2.0 * knee);
    rq = rq * rq * 0.25 / knee;
    return color * max(rq, brightness - threshold) / max(brightness, 1e-4);
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 outputSize = imageSize(outputMip);
    
    if (coord.x >= outputSize.x || coord.y >= outputSize.y) {
        return;
    }
    
    ivec2 inputSize = textureSize(inputMip, mipLevel);
    vec2 texelSize = 1.0 / vec2(inputSize);
    //vec2 uv = (vec2(coord) + 0.5) / vec2(outputSize);
    vec2 uv = (vec2(coord) * 2.0 + 1.0) * texelSize;

    float lod = float(mipLevel);
    vec4 color = vec4(0.0);
    vec2 h = texelSize * 0.5; // half texel

    vec4 a = textureLod(inputMip, uv - h, lod);
    vec4 b = textureLod(inputMip, uv + vec2(h.x, -h.y), lod);
    vec4 c = textureLod(inputMip, uv + vec2(-h.x, h.y), lod);
    vec4 d = textureLod(inputMip, uv + h, lod);
    color += (a + b + c + d) * 0.125;

    color += textureLod(inputMip, uv + vec2( 0.0, -1.5) * texelSize, lod) * 0.0625;
    color += textureLod(inputMip, uv + vec2( 0.0,  1.5) * texelSize, lod) * 0.0625;
    color += textureLod(inputMip, uv + vec2(-1.5,  0.0) * texelSize, lod) * 0.0625;
    color += textureLod(inputMip, uv + vec2( 1.5,  0.0) * texelSize, lod) * 0.0625;
    
    color += textureLod(inputMip, uv + vec2(-1.5, -1.5) * texelSize, lod) * 0.03125;
    color += textureLod(inputMip, uv + vec2( 1.5, -1.5) * texelSize, lod) * 0.03125;
    color += textureLod(inputMip, uv + vec2(-1.5,  1.5) * texelSize, lod) * 0.03125;
    color += textureLod(inputMip, uv + vec2( 1.5,  1.5) * texelSize, lod) * 0.03125;

    vec4 m = textureLod(inputMip, uv, lod);
    
    // Apply brightness threshold only on first downsample
    if (mipLevel == 0) {
        color.rgb = QuadraticThreshold(color.rgb, bloomThreshold, bloomKnee);
    }
    
    imageStore(outputMip, coord, color);
}