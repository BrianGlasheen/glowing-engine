#version 460

layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 0, rgba16f) uniform image2D currentMip;     // READ_WRITE
layout(binding = 1, rgba16f) uniform readonly image2D higherMip;  // READ_ONLY (smaller/higher mip)

uniform float strength = 1.0;
uniform int mipLevel = 0;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 currentSize = imageSize(currentMip);
    
    if (coord.x >= currentSize.x || coord.y >= currentSize.y) {
        return;
    }
    
    vec4 current = imageLoad(currentMip, coord);
    ivec2 higherSize = imageSize(higherMip);
    
    vec2 uv = (vec2(coord) + 0.5) / vec2(currentSize);
    vec2 texelSize = 1.0 / vec2(higherSize);
    
    // Center sample
    vec2 centerUV = uv;
    ivec2 centerCoord = ivec2(centerUV * higherSize);
    centerCoord = clamp(centerCoord, ivec2(0), higherSize - 1);
    
    vec4 upsampled = vec4(0.0);
    
    upsampled += imageLoad(higherMip, clamp(centerCoord + ivec2(-1, -1), ivec2(0), higherSize - 1)) * 1.0;
    upsampled += imageLoad(higherMip, clamp(centerCoord + ivec2( 0, -1), ivec2(0), higherSize - 1)) * 2.0;
    upsampled += imageLoad(higherMip, clamp(centerCoord + ivec2( 1, -1), ivec2(0), higherSize - 1)) * 1.0;
    
    upsampled += imageLoad(higherMip, clamp(centerCoord + ivec2(-1,  0), ivec2(0), higherSize - 1)) * 2.0;
    upsampled += imageLoad(higherMip, clamp(centerCoord + ivec2( 0,  0), ivec2(0), higherSize - 1)) * 4.0;
    upsampled += imageLoad(higherMip, clamp(centerCoord + ivec2( 1,  0), ivec2(0), higherSize - 1)) * 2.0;
    
    upsampled += imageLoad(higherMip, clamp(centerCoord + ivec2(-1,  1), ivec2(0), higherSize - 1)) * 1.0;
    upsampled += imageLoad(higherMip, clamp(centerCoord + ivec2( 0,  1), ivec2(0), higherSize - 1)) * 2.0;
    upsampled += imageLoad(higherMip, clamp(centerCoord + ivec2( 1,  1), ivec2(0), higherSize - 1)) * 1.0;
    
    upsampled /= 16.0;
    
    vec4 result = current + upsampled * strength;
    
    imageStore(currentMip, coord, result);
}