#version 460
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0, rgba16f) uniform image2D currentMip;     // READ_WRITE
layout(binding = 1, rgba16f) uniform readonly image2D higherMip;  // READ_ONLY (smaller/higher mip)

uniform float bloomStrength = 1.0;
uniform float bloomRadius = 1.0;
uniform int mipLevel = 0;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 currentSize = imageSize(currentMip);
    
    if (coord.x >= currentSize.x || coord.y >= currentSize.y) {
        return;
    }
    
    vec4 current = imageLoad(currentMip, coord);
    ivec2 higherSize = imageSize(higherMip);
    
    // Tent filter upsampling (9-tap)
    vec2 uv = (vec2(coord) + 0.5) / vec2(currentSize);
    vec2 texelSize = 1.0 / vec2(higherSize);
    
    // 9-tap tent filter for smooth upsampling
    vec4 upsampled = vec4(0.0);
    
    // Center sample
    vec2 centerUV = uv;
    ivec2 centerCoord = ivec2(centerUV * higherSize);
    centerCoord = clamp(centerCoord, ivec2(0), higherSize - 1);
    upsampled += imageLoad(higherMip, centerCoord) * 4.0;
    
    // Edge samples
    for (int x = -1; x <= 1; x++) {
        for (int y = -1; y <= 1; y++) {
            if (x == 0 && y == 0) continue; // Skip center (already sampled)
            
            vec2 sampleUV = uv + vec2(x, y) * texelSize;
            ivec2 sampleCoord = ivec2(sampleUV * higherSize);
            sampleCoord = clamp(sampleCoord, ivec2(0), higherSize - 1);
            
            float weight = (abs(x) == 1 && abs(y) == 1) ? 1.0 : 2.0; // Corner vs edge
            upsampled += imageLoad(higherMip, sampleCoord) * weight;
        }
    }
    upsampled /= 16.0; // Normalize weights (4 + 4*2 + 4*1 = 16)
    
    // Additional blur pass for sledgehammer effect
    vec4 blurred = vec4(0.0);
    float totalWeight = 0.0;
    
    // 5x5 blur kernel for extra smoothness
    for (int x = -2; x <= 2; x++) {
        for (int y = -2; y <= 2; y++) {
            ivec2 sampleCoord = coord + ivec2(x, y);
            sampleCoord = clamp(sampleCoord, ivec2(0), currentSize - 1);
            
            float distance = length(vec2(x, y));
            float weight = exp(-distance * distance * 0.5); // Gaussian-like weight
            
            blurred += imageLoad(currentMip, sampleCoord) * weight;
            totalWeight += weight;
        }
    }
    blurred /= totalWeight;
    
    // Blend current with blurred version based on mip level
    float blurStrength = min(float(mipLevel) * 0.2, 0.6);
    current = mix(current, blurred, blurStrength);
    
    // Combine with upsampled data
    float strength = bloomStrength * bloomRadius;
    vec4 result = current + upsampled * strength;
    
    imageStore(currentMip, coord, result);
}